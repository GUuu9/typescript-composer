{
  "schemaVersion": 1,
  "id": "electron-phaser",
  "version": "0.0.0",
  "kind": "target",
  "areas": [
    "backend",
    "preload",
    "frontend"
  ],
  "frameworks": [
    "electron",
    "phaser"
  ],
  "requires": [
    "electron-backend",
    "phaser"
  ],
  "scripts": {
    "dev": "node scripts/electronDev.mjs",
    "start": "node scripts/electronStart.mjs",
    "check": "node scripts/electronAreas.mjs check",
    "test": "node scripts/electronAreas.mjs test",
    "build": "node scripts/electronAreas.mjs build"
  },
  "replacements": [
    {
      "path": "scripts/electronTarget.mjs",
      "owner": "electron-backend"
    },
    {
      "path": "src/backend/core/electronTarget.ts",
      "owner": "electron-backend"
    },
    {
      "path": "scripts/webTarget.mjs",
      "owner": "phaser"
    }
  ]
}
