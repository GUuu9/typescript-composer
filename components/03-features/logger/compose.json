{
  "schemaVersion": 1,
  "id": "logger",
  "version": "0.0.0",
  "kind": "feature",
  "areas": [
    "backend"
  ],
  "frameworks": [
    "node"
  ],
  "requires": [
    "backend-common"
  ],
  "environment": {
    "LOGGER_LEVEL": {
      "description": "debug/info/warn/error. 기본 info",
      "required": false,
      "secret": false
    },
    "LOGGER_OUTPUT": {
      "description": "console/file/both. 기본 console. file/both 명시 시 앱 logs/에 회전 저장",
      "required": false,
      "secret": false
    }
  },
  "registrations": [
    {
      "name": "logger",
      "area": "backend",
      "module": "src/backend/services/logger/logger.service.ts",
      "factory": "createLoggerService",
      "dependencies": {},
      "lifecycle": [
        "initialize",
        "dispose"
      ]
    }
  ]
}
