{
  "schemaVersion": 1,
  "id": "mqtt",
  "version": "0.0.0",
  "kind": "feature",
  "areas": [
    "backend"
  ],
  "frameworks": [
    "node"
  ],
  "requires": [
    "backend-common"
  ],
  "environment": {
    "MQTT_URL": {
      "description": "mqtt/mqtts broker URL. 자동 시작 시 필수, URL 자격 증명 금지",
      "required": true,
      "secret": false
    },
    "MQTT_CLIENT_ID": {
      "description": "1~64자 영문/숫자/밑줄/하이픈. 자동 시작 시 필수",
      "required": true,
      "secret": false
    },
    "MQTT_USERNAME": {
      "description": "선택 브로커 계정",
      "required": false,
      "secret": true
    },
    "MQTT_PASSWORD": {
      "description": "선택 브로커 비밀번호",
      "required": false,
      "secret": true
    },
    "MQTT_AUTO_START": {
      "description": "true/false. 빈 값은 생성 시 선택",
      "required": false,
      "secret": false
    }
  },
  "registrations": [
    {
      "name": "mqtt",
      "area": "backend",
      "module": "src/backend/communications/mqtt/mqtt.communication.ts",
      "factory": "createMqttCommunication",
      "dependencies": {},
      "lifecycle": []
    }
  ],
  "communications": [
    {
      "registration": "mqtt",
      "area": "backend",
      "configModule": "src/backend/config/mqtt.config.ts",
      "configFactory": "readMqttConfig",
      "protocol": "mqtt",
      "failure": true
    }
  ],
  "packages": {
    "dependencies": {
      "mqtt": "5.16.1"
    }
  }
}
