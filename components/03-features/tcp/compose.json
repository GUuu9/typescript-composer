{
  "schemaVersion": 1,
  "id": "tcp",
  "version": "0.0.0",
  "kind": "feature",
  "areas": [
    "backend"
  ],
  "frameworks": [
    "node"
  ],
  "requires": [
    "backend-common"
  ],
  "environment": {
    "TCP_HOST": {
      "description": "IP 또는 localhost. 기본 127.0.0.1",
      "required": false,
      "secret": false
    },
    "TCP_PORT": {
      "description": "1~65535 정수. 기본 4000",
      "required": false,
      "secret": false
    },
    "TCP_AUTO_START": {
      "description": "true 또는 false. 빈 값은 생성 시 선택",
      "required": false,
      "secret": false
    },
    "TCP_AUTH_TOKEN": {
      "description": "공백 없는 ASCII 32~256자. loopback 외 bind 필수, 평문 TCP 인증 비밀값",
      "required": false,
      "secret": true
    }
  },
  "registrations": [
    {
      "name": "tcp",
      "area": "backend",
      "module": "src/backend/communications/tcp/tcp.communication.ts",
      "factory": "createTcpCommunication",
      "dependencies": {},
      "lifecycle": []
    }
  ],
  "communications": [
    {
      "registration": "tcp",
      "area": "backend",
      "configModule": "src/backend/config/tcp.config.ts",
      "configFactory": "readTcpConfig",
      "protocol": "tcp",
      "failure": true
    }
  ],
  "scripts": {
    "test:tcp:slow": "node --test --test-name-pattern=\"^slow:\" \"test/backend/tcp.test.ts\""
  }
}
