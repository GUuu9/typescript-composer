{
  "schemaVersion": 1,
  "id": "socket-io",
  "version": "0.0.0",
  "kind": "feature",
  "areas": [
    "backend"
  ],
  "frameworks": [
    "node"
  ],
  "requires": [
    "http"
  ],
  "environment": {
    "SOCKET_IO_AUTH_TOKEN": {
      "description": "Origin 없는 client 또는 외부 bind 필수 ASCII 32~256자 토큰",
      "required": false,
      "secret": true
    },
    "SOCKET_IO_AUTO_START": {
      "description": "true/false. 빈 값은 생성 시 선택",
      "required": false,
      "secret": false
    }
  },
  "registrations": [
    {
      "name": "socketIo",
      "area": "backend",
      "module": "src/backend/communications/socketIo/socketIo.communication.ts",
      "factory": "createSocketIoCommunication",
      "dependencies": {
        "http": "http"
      },
      "lifecycle": []
    }
  ],
  "communications": [
    {
      "registration": "socketIo",
      "area": "backend",
      "configModule": "src/backend/config/socketIo.config.ts",
      "configFactory": "readSocketIoConfig",
      "protocol": "socketIo",
      "failure": true
    }
  ],
  "packages": {
    "dependencies": {
      "socket.io": "4.8.4",
      "engine.io": "6.6.11"
    }
  }
}
